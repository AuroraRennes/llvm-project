# RUN: llc -mtriple=aarch64-linux-musl -hbng -hbng-prera-sends -run-pass=hbng-check-sends -verify-machineinstrs -o - %s | FileCheck %s

# Two adjacent sends through the same page register become one pair, in the
# order the channel receives them. A W register is paired as its X register.
# CHECK-LABEL: name: pair
# CHECK:      $x8 = ADRP target-flags(aarch64-page) &__hbng_chan
# CHECK-NEXT: HBNG_SEND_PAIR $x8, $x1, $x2
# CHECK-NEXT: $x0 = LDRXroW $x1, $w2, 1, 1
---
name: pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $w2, $lr
    $x8 = ADRP target-flags(aarch64-page) &__hbng_chan
    HBNG_SEND $x8, $x1
    HBNG_SEND_W $x8, $w2
    $x0 = LDRXroW $x1, $w2, 1, 1
    RET undef $lr, implicit $x0
...

# Not through the same page register: no pair.
# CHECK-LABEL: name: two_pages
# CHECK:      HBNG_SEND $x8, $x1
# CHECK-NEXT: HBNG_SEND $x9, $x2
---
name: two_pages
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2, $lr
    $x8 = ADRP target-flags(aarch64-page) &__hbng_chan
    $x9 = ADRP target-flags(aarch64-page) &__hbng_chan
    HBNG_SEND $x8, $x1
    HBNG_SEND $x9, $x2
    $x0 = LDRXroX $x1, $x2, 0, 1
    RET undef $lr, implicit $x0
...

# A send moves up to the previous one when nothing in between writes its
# register or the page: the access in between keeps its own send.
# CHECK-LABEL: name: hoist
# CHECK:      HBNG_SEND_PAIR $x8, $x1, $x2
# CHECK-NEXT: STRXui $x3, killed $x1, 0
# CHECK-NEXT: $x0 = LDRXui killed $x2, 0
---
name: hoist
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2, $x3, $lr
    $x8 = ADRP target-flags(aarch64-page) &__hbng_chan
    HBNG_SEND $x8, $x1
    STRXui $x3, killed $x1, 0
    HBNG_SEND killed $x8, $x2
    $x0 = LDRXui killed $x2, 0
    RET undef $lr, implicit $x0
...

# The second send's register is written in between: no pair.
# CHECK-LABEL: name: written_between
# CHECK:      HBNG_SEND $x8, $x1
# CHECK-NEXT: $x2 = LDRXui killed $x1, 0
# CHECK-NEXT: HBNG_SEND killed $x8, $x2
---
name: written_between
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $lr
    $x8 = ADRP target-flags(aarch64-page) &__hbng_chan
    HBNG_SEND $x8, $x1
    $x2 = LDRXui killed $x1, 0
    HBNG_SEND killed $x8, $x2
    $x0 = LDRXui killed $x2, 0
    RET undef $lr, implicit $x0
...

# A store-exclusive in between: the send stays after it, so that no store
# comes between the exclusive pair.
# CHECK-LABEL: name: exclusive_between
# CHECK:      HBNG_SEND $x8, $x1
# CHECK-NEXT: early-clobber $w9 = STXRX $x3, $x1
# CHECK-NEXT: HBNG_SEND killed $x8, $x2
---
name: exclusive_between
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2, $x3, $lr
    $x8 = ADRP target-flags(aarch64-page) &__hbng_chan
    HBNG_SEND $x8, $x1
    early-clobber $w9 = STXRX $x3, $x1
    HBNG_SEND killed $x8, $x2
    $x0 = LDRXui killed $x2, 0
    RET undef $lr, implicit $x0, implicit $w9
...
