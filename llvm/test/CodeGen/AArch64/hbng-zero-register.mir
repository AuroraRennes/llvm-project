# The zero register as a register offset: the send pass sends it like any
# offset register, a FIFO entry of 0 ("send XZR"), and the address is the
# base alone.
# RUN: llc -mtriple=aarch64-linux-musl -mattr=+reserve-x18 -hbng -start-before=hbng-send-stm %s -o - | FileCheck %s

# CHECK-LABEL: HBNG_zero_index:
# CHECK-NEXT:  stp xzr, x0, [x18]
# CHECK-NEXT:  str xzr, [x0, xzr, lsl #3]
# CHECK-LABEL: HBNG_zero_index_annot:
# CHECK-NEXT:  .ascii "@0\n"
# CHECK-NEXT:  .ascii "send X0\n"
# CHECK-NEXT:  .ascii "send XZR\n"
# CHECK-NEXT:  .ascii "@4\n"
# CHECK-NEXT:  .ascii "M[<X0> .. +8] <- 0\n"
# CHECK-NEXT:  .ascii "@8\n"
# CHECK-NEXT:  .ascii "END\n"

--- |
  target triple = "aarch64-unknown-linux-musl"
  define void @zero_index(ptr %p) { ret void }
...
---
name: zero_index
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    STRXroX $xzr, $x0, $xzr, 0, 1
    RET undef $lr
...
