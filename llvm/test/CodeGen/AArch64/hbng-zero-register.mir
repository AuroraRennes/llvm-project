# The zero register as a register offset adds nothing to the address, which is
# the base alone: only the base is sent.
# RUN: llc -mtriple=aarch64-linux-musl -mattr=+reserve-x18 -hbng -start-before=hbng-send-stm %s -o - | FileCheck %s --check-prefixes=CHECK,X18
# RUN: llc -mtriple=aarch64-linux-musl -hbng -hbng-prera-sends -start-before=hbng-prera-sends-insert %s -o - | FileCheck %s --check-prefixes=CHECK,PRERA

# CHECK-LABEL: HBNG_zero_index:
# X18-NEXT:    str x0, [x18]
# PRERA-NEXT:  adrp x8, __hbng_chan
# PRERA-NEXT:  str x0, [x8]
# CHECK-NEXT:  str xzr, [x0, xzr, lsl #3]
# CHECK-LABEL: HBNG_zero_index_annot:
# CHECK-NEXT:  .ascii "@0\n"
# PRERA-NEXT:  .ascii "X8 <- 0\n"
# PRERA-NEXT:  .ascii "@4\n"
# CHECK-NEXT:  .ascii "send X0\n"
# CHECK-NEXT:  .ascii "@{{4|8}}\n"
# CHECK-NEXT:  .ascii "M[<X0> .. +8] <- 0\n"
# CHECK-NEXT:  .ascii "@{{8|12}}\n"
# CHECK-NEXT:  .ascii "END\n"

--- |
  target triple = "aarch64-unknown-linux-musl"
  define void @zero_index(ptr %p) { ret void }
...
---
name: zero_index
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    STRXroX $xzr, $x0, $xzr, 0, 1
    RET undef $lr
...
